# dev-pal authenticates as the it@finlink.de technical user. Never name this
# JIRA_API_TOKEN: that generic name shadows ATLASSIAN_API_TOKEN in tools that
# prefer a per-product token. aliases.zsh injects it for fl/dev-pal only.
export DEVPAL_JIRA_API_TOKEN=

# Your own Atlassian credentials. Unscoped token, pairs with your own email.
export PRIVATE_JIRA_USER=
export ATLASSIAN_API_TOKEN=
export ATLASSIAN_BASE_URL=https://finlink.atlassian.net
export ATLASSIAN_EMAIL="$PRIVATE_JIRA_USER"

export BUNDLE_RUBYGEMS__PKG__GITHUB__COM=

{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "external_directory": {
      "~/Projects/finlink/**": "allow"
    },
    "bash": {
      "*": "ask",
      "bundle exec rspec *": "allow",
      "cat *": "allow",
      "column *": "allow",
      "cut *": "allow",
      "df *": "allow",
      "diff *": "allow",
      "docker compose exec *": "allow",
      "du *": "allow",
      "echo *": "allow",
      "file *": "allow",
      "find *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr checks *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh repo view *": "allow",
      "git branch *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git status *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "jq *": "allow",
      "less *": "allow",
      "ls *": "allow",
      "more *": "allow",
      "pwd *": "allow",
      "read *": "allow",
      "rg *": "allow",
      "rspec *": "allow",
      "sort *": "allow",
      "stat *": "allow",
      "tail *": "allow",
      "tr *": "allow",
      "tree *": "allow",
      "uniq *": "allow",
      "wc *": "allow",
      "which *": "allow"
    }
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/sse",
      "enabled": true,
      "oauth": {}
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "Miro": {
      "type": "remote",
      "url": "https://mcp.miro.com",
      "oauth": {}
    },
    "Slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp",
      "oauth": {}
    }
  },
  "lsp": {
    "solargraph": {
      "command": ["solargraph", "stdio"],
      "extensions": [".rb", ".erb", ".rake", ".gemspec", ".ru", ".pryrc"],
      "initialization": {
        "solargraph": {
          "diagnostics": true,
          "completion": true,
          "hover": true
        }
      }
    }
  }
}

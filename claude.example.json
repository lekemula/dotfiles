{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec:*)",
      "Bash(cat:*)",
      "Bash(column:*)",
      "Bash(cut:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(docker compose exec:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(more:*)",
      "Bash(pwd:*)",
      "Bash(read:*)",
      "Bash(rg:*)",
      "Bash(rspec:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "mcp__claude_ai_Atlassian__getJiraIssue"
    ],
    "deny": [],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit -m:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Projects/finlink"
    ]
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "workmux-claude-status waiting"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status blocked"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux-claude-status working"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status working"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-session-retro-hook",
            "timeout": 10,
            "statusMessage": "Drafting session retro"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__claude_ai_Atlassian__(createJiraIssue|editJiraIssue)",
        "hooks": [
          {
            "type": "command",
            "command": "claude-jira-skill-gate",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status working"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-session-retro-hook",
            "timeout": 10,
            "statusMessage": "Drafting session retro"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status clear"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/lekemula/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude-retro-inbox-notice",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux-claude-status done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status idle"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux-claude-status done"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status done"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status error"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "workmux-claude-status working"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/lekemula/.config/iterm2/cc-status"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "rex-claude-status working"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "$HOME/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "layered-rails@palkan-skills": true,
    "lua-lsp@claude-plugins-official": true,
    "mattpocock-skills@mattpocock": true,
    "playwright@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": false,
    "solargraph@local-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "ruby-toolkit@finlink": false,
    "github-toolkit@finlink": false,
    "atlassian-toolkit@finlink": true,
    "customer-success@finlink": true,
    "fl-sdd@finlink": true,
    "marketplace-dev@finlink": false,
    "pm-toolkit@finlink": false,
    "todoist@doist": true,
    "merman@merman": true,
    "image-view@claude-image-view": true,
    "filetree@claude-code-filetree": true,
    "replay-theater@local-plugins": true
  },
  "extraKnownMarketplaces": {
    "doist": {
      "source": {
        "source": "github",
        "repo": "doist/todoist-mcp"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "local-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/lekemula/.claude/local-plugins"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "finlink": {
      "source": {
        "source": "github",
        "repo": "LoanLink/skills-marketplace"
      },
      "autoUpdate": false
    },
    "merman": {
      "source": {
        "source": "github",
        "repo": "iamrohithrnair/merman"
      }
    },
    "claude-image-view": {
      "source": {
        "source": "github",
        "repo": "jarrodwatts/claude-image-view"
      }
    },
    "claude-code-filetree": {
      "source": {
        "source": "github",
        "repo": "data-goblin/claude-code-filetree"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "filetree@claude-code-filetree": {
      "options": {
        "transparent": "on",
        "palette": "fg=#e6edf3 muted=#7d8590 accent=#4493f8 selection=#1f2a3a hover=#161b22 urgent=#f85149 added=#3fb950 modified=#d29922 renamed=#4493f8 add=#3fb950 del=#f85149",
        "open": "/Users/lekemula/dotfiles/bin/rex-open-path --file {path}",
        "edit": "/Users/lekemula/dotfiles/bin/rex-open-path --file {path} {line}",
        "binaries": "default app",
        "collapse": "on",
        "hidden": "show"
      }
    }
  },
  "tui": "fullscreen",
  "theme": "dark-ansi",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true,
  "mcpServers": {}
}

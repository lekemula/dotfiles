{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bundle exec rspec:*)",
      "Bash(cat:*)",
      "Bash(column:*)",
      "Bash(cut:*)",
      "Bash(df:*)",
      "Bash(diff:*)",
      "Bash(docker compose exec:*)",
      "Bash(du:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh repo view:*)",
      "Bash(git branch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(less:*)",
      "Bash(ls:*)",
      "Bash(more:*)",
      "Bash(pwd:*)",
      "Bash(read:*)",
      "Bash(rg:*)",
      "Bash(rspec:*)",
      "Bash(sort:*)",
      "Bash(stat:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "mcp__claude_ai_Atlassian__getJiraIssue"
    ],
    "deny": [],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit -m:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/Projects/finlink"
    ]
  },
  "model": "opus[1m]",
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "playwright@claude-plugins-official": true,
    "layered-rails@palkan-skills": true,
    "github@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "warp@claude-code-warp": true,
    "ruby-lsp@claude-plugins-official": true,
    "solargraph@local-plugins": true,
    "fl-sdd@finlink": true,
    "github-toolkit@finlink": true,
    "marketplace-dev@finlink": true,
    "ruby-toolkit@finlink": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "local-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/lekemula/.claude/local-plugins"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "theme": "dark",
  "editorMode": "vim",
  "skipAutoPermissionPrompt": true,
  "mcpServers": {},
  "feedbackSurveyState": {
    "lastShownTime": 1754072297712
  },
  "hooks": {"SessionStart":[{"matcher":"*","hooks":[{"type":"command","command":"bash '/Users/lekemula/.claude/hooks/herdr-agent-state.sh' session","timeout":10}]}]}
}

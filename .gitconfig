# See https://digitalfortress.tech/tutorial/create-global-gitconfig-git-alias/
# Add your preferred git settings here. This will overwrite anything in `core/configs/.gitconfig`.
[core]
  excludesfile = ~/.gitignore_global
  pager = delta
	editor = nvim
	attributesfile = ~/.gitattributes

[user]
  name = Lekë Mula
  email = l.mula@finlink.de

[interactive]
  diffFilter = delta --color-only

[diff]
  colorMoved = default
  # Structural, syntax-aware diffs on demand - https://github.com/Wilfred/difftastic
  # Deliberately NOT diff.external: that would change `git diff` output for every
  # tool that parses it, and difftastic's ANSI-only colours can't match delta's theme.
  tool = difftastic

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[pager]
  # Plain less, NOT core.pager (delta): delta expects a unified diff and would
  # repaint difftastic's whole left column red and right column green.
  difftool = less -FRX

[alias]
  # Difftastic on demand, for refactors where line-level diffs are all noise
  # (reindentation, wrapping code in a module, reflowing long lines).
  ddiff = "!git -c diff.external=difft -c core.pager='less -FRX' diff"
  dshow = "!git -c diff.external=difft -c core.pager='less -FRX' show"
  dlog = "!git -c diff.external=difft -c core.pager='less -FRX' log -p"

[delta]
  navigate = true    # use n and N to move between diff sections
  light = false      # set to true if you're in a terminal w/ a light background color (e.g. the default macOS terminal)
  side-by-side=true

[merge]
  conflictstyle = diff3

[rebase]
  autoStash = true
  autoSquash = true
	updateRefs = true

[pull]
  rebase = true

[push]
	autoSetupRemote = true

[rerere]
	enabled = true

[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager

[credential "https://dev.azure.com"]
	useHttpPath = true

[absorb]
    maxStack=30
    oneFixupPerCommit = true
